<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <!-- Poster grid / list. Padding top/bottom is set in code to clear the header and bottom nav. -->
    <GridView
        android:id="@+id/grid"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:drawSelectorOnTop="false"
        android:horizontalSpacing="8dp"
        android:listSelector="@android:color/transparent"
        android:numColumns="3"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:scrollbarStyle="outsideOverlay"
        android:stretchMode="columnWidth"
        android:verticalSpacing="8dp" />

    <!-- Empty state -->
    <LinearLayout
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingLeft="40dp"
        android:paddingRight="40dp"
        android:visibility="gone">
        <ImageView
            android:id="@+id/emptyIcon"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/action_circle"
            android:padding="16dp"
            android:src="@drawable/ic_movie"
            android:tint="@color/muted" />
        <TextView
            android:id="@+id/emptyTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:textColor="@color/text"
            android:textSize="18sp" />
        <TextView
            android:id="@+id/emptyText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/muted"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/emptyAdd"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/btn_accent"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:paddingLeft="22dp"
            android:paddingRight="22dp"
            android:text="+  Add video"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- Sticky translucent header -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:animateLayoutChanges="true"
        android:background="@drawable/header_bg"
        android:elevation="2dp"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="16dp"
            android:paddingRight="6dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:letterSpacing="-0.01"
                android:maxLines="1"
                android:text="Video Notebook"
                android:textColor="@color/text"
                android:textSize="21sp"
                android:textStyle="bold" />
            <ImageButton
                android:id="@+id/searchBtn"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/ripple_round"
                android:contentDescription="Search"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_search"
                android:tint="@color/text" />
            <ImageButton
                android:id="@+id/viewBtn"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/ripple_round"
                android:contentDescription="Change view"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_grid3"
                android:tint="@color/text" />
            <ImageButton
                android:id="@+id/sortBtn"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/ripple_round"
                android:contentDescription="Sort"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_sort"
                android:tint="@color/text" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/searchRow"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginBottom="10dp"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="12dp"
            android:background="@drawable/search_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="12dp"
            android:visibility="gone">
            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_search"
                android:tint="@color/muted" />
            <EditText
                android:id="@+id/searchInput"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/search_hint"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:paddingLeft="10dp"
                android:textColor="@color/text"
                android:textColorHint="@color/faint"
                android:textSize="15sp" />
            <ImageButton
                android:id="@+id/searchClose"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/ripple_round"
                android:contentDescription="Close search"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_close"
                android:tint="@color/muted" />
        </LinearLayout>
    </LinearLayout>

    <!-- Toast / snackbar with optional Undo -->
    <LinearLayout
        android:id="@+id/snack"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_gravity="bottom"
        android:layout_marginBottom="84dp"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:background="@drawable/snack_bg"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="16dp"
        android:visibility="gone">
        <TextView
            android:id="@+id/snackText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/snackUndo"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="@drawable/ripple_rect"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:text="UNDO"
            android:textColor="@color/accent_light"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Floating add button with glow -->
    <FrameLayout
        android:id="@+id/fabWrap"
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:layout_gravity="bottom|end"
        android:layout_marginBottom="68dp"
        android:layout_marginEnd="4dp">
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/fab_glow" />
        <ImageButton
            android:id="@+id/fab"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center"
            android:background="@drawable/fab_bg"
            android:contentDescription="@string/add_video"
            android:elevation="6dp"
            android:padding="15dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_add"
            android:tint="#FFFFFF" />
    </FrameLayout>

    <!-- Bottom navigation -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_gravity="bottom"
        android:background="@drawable/nav_bg"
        android:elevation="8dp"
        android:orientation="horizontal">
        <LinearLayout
            android:id="@+id/navAll"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/ripple_rect"
            android:gravity="center"
            android:orientation="vertical">
            <FrameLayout
                android:layout_width="80dp"
                android:layout_height="36dp">
                <View
                    android:id="@+id/navAllPill"
                    android:layout_width="64dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:background="@drawable/nav_pill" />
                <ImageView
                    android:id="@+id/navAllIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_grid3" />
                <TextView
                    android:id="@+id/navAllBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="18dp"
                    android:layout_gravity="top|end"
                    android:layout_marginEnd="2dp"
                    android:background="@drawable/badge"
                    android:gravity="center"
                    android:minWidth="18dp"
                    android:paddingLeft="5dp"
                    android:paddingRight="5dp"
                    android:text="0"
                    android:textColor="@color/text"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </FrameLayout>
            <TextView
                android:id="@+id/navAllLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="All"
                android:textSize="12sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/navDraft"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/ripple_rect"
            android:gravity="center"
            android:orientation="vertical">
            <FrameLayout
                android:layout_width="80dp"
                android:layout_height="36dp">
                <View
                    android:id="@+id/navDraftPill"
                    android:layout_width="64dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:background="@drawable/nav_pill" />
                <ImageView
                    android:id="@+id/navDraftIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_clock" />
                <TextView
                    android:id="@+id/navDraftBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="18dp"
                    android:layout_gravity="top|end"
                    android:layout_marginEnd="2dp"
                    android:background="@drawable/badge"
                    android:gravity="center"
                    android:minWidth="18dp"
                    android:paddingLeft="5dp"
                    android:paddingRight="5dp"
                    android:text="0"
                    android:textColor="@color/text"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </FrameLayout>
            <TextView
                android:id="@+id/navDraftLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Not Yet"
                android:textSize="12sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/navPub"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/ripple_rect"
            android:gravity="center"
            android:orientation="vertical">
            <FrameLayout
                android:layout_width="80dp"
                android:layout_height="36dp">
                <View
                    android:id="@+id/navPubPill"
                    android:layout_width="64dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:background="@drawable/nav_pill" />
                <ImageView
                    android:id="@+id/navPubIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_check_circle" />
                <TextView
                    android:id="@+id/navPubBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="18dp"
                    android:layout_gravity="top|end"
                    android:layout_marginEnd="2dp"
                    android:background="@drawable/badge"
                    android:gravity="center"
                    android:minWidth="18dp"
                    android:paddingLeft="5dp"
                    android:paddingRight="5dp"
                    android:text="0"
                    android:textColor="@color/text"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </FrameLayout>
            <TextView
                android:id="@+id/navPubLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Published"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
