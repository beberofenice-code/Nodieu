<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/folderCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/folder_light"
    android:elevation="2dp"
    android:gravity="center_vertical"
    android:minHeight="100dp"
    android:orientation="horizontal"
    android:paddingBottom="16dp"
    android:paddingLeft="16dp"
    android:paddingRight="8dp"
    android:paddingTop="16dp"
    android:stateListAnimator="@animator/press_scale">

    <FrameLayout
        android:id="@+id/fTile"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/tile_blue"
        android:elevation="3dp">
        <ImageView
            android:id="@+id/fIcon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_folder"
            android:tint="#FFFFFF" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:id="@+id/fType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.14"
            android:textColor="@color/tagalog"
            android:textSize="10.5sp" />
        <TextView
            android:id="@+id/fName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/home_text"
            android:textSize="18sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/fCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFeatureSettings="tnum"
            android:textColor="@color/home_muted"
            android:textSize="13sp" />
        <ProgressBar
            android:id="@+id/fBar"
            style="@android:style/Widget.Material.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="10dp"
            android:max="100"
            android:progressDrawable="@drawable/bar_blue" />
    </LinearLayout>

    <ImageView
        android:id="@+id/fMore"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/ripple_round_dark"
        android:contentDescription="Folder options"
        android:padding="9dp"
        android:src="@drawable/ic_more"
        android:tint="@color/home_muted" />
</LinearLayout>
