<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/folderCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/folder_blue"
    android:elevation="3dp"
    android:gravity="center_vertical"
    android:minHeight="104dp"
    android:orientation="horizontal"
    android:paddingBottom="16dp"
    android:paddingLeft="16dp"
    android:paddingRight="10dp"
    android:paddingTop="16dp"
    android:stateListAnimator="@animator/press_scale">

    <ImageView
        android:id="@+id/fIcon"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="@drawable/folder_icon_bg"
        android:padding="13dp"
        android:src="@drawable/ic_folder"
        android:tint="#FFFFFF" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:id="@+id/fType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0.8"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.14"
            android:textColor="#FFFFFF"
            android:textSize="10.5sp" />
        <TextView
            android:id="@+id/fName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textSize="19sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/fCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:alpha="0.85"
            android:fontFeatureSettings="tnum"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />
        <ProgressBar
            android:id="@+id/fBar"
            style="@android:style/Widget.Material.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="10dp"
            android:max="100"
            android:progressDrawable="@drawable/folder_bar" />
    </LinearLayout>

    <ImageView
        android:id="@+id/fMore"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/ripple_round"
        android:contentDescription="Folder options"
        android:padding="9dp"
        android:src="@drawable/ic_more"
        android:tint="#FFFFFF" />
</LinearLayout>
