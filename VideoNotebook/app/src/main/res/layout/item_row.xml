<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/card_bg"
    android:stateListAnimator="@animator/press_scale">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">

        <FrameLayout
            android:id="@+id/thumbWrap"
            android:layout_width="60dp"
            android:layout_height="90dp"
            android:background="@drawable/thumb_bg">
            <ImageView
                android:id="@+id/fallback"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_movie"
                android:tint="#3A3F52" />
            <ImageView
                android:id="@+id/thumb"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <LinearLayout
                android:id="@+id/badge"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:background="@drawable/status_pub"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="7dp"
                android:paddingRight="8dp">
                <View
                    android:id="@+id/badgeDot"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:background="@drawable/dot_pub" />
                <TextView
                    android:id="@+id/badgeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:fontFamily="sans-serif-medium"
                    android:textSize="10.5sp" />
            </LinearLayout>
            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="2"
                android:textColor="@color/text"
                android:textSize="15sp" />
            <TextView
                android:id="@+id/label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:fontFeatureSettings="tnum"
                android:maxLines="1"
                android:textColor="@color/muted"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/extra"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/accent_light"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/quick"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/ripple_round"
            android:clickable="true"
            android:contentDescription="Quick actions"
            android:focusable="false"
            android:padding="8dp"
            android:src="@drawable/ic_more"
            android:tint="@color/muted" />
    </LinearLayout>
</FrameLayout>
