<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingLeft="20dp"
    android:paddingRight="20dp"
    android:paddingTop="8dp">

    <EditText
        android:id="@+id/dName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Folder name"
        android:inputType="textCapWords"
        android:singleLine="true" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:letterSpacing="0.08"
        android:text="TYPE"
        android:textColor="@color/muted"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">
        <LinearLayout
            android:id="@+id/dTagalog"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_marginRight="6dp"
            android:layout_weight="1"
            android:background="@drawable/type_blue_on"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:id="@+id/dTagalogText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="Tagalog Dub"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/dTagalogSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Blue"
                android:textColor="#BFDBFE"
                android:textSize="12sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/dEnglish"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_marginLeft="6dp"
            android:layout_marginRight="6dp"
            android:layout_weight="1"
            android:background="@drawable/type_off"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:id="@+id/dEnglishText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="English Dub"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/dEnglishSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Red"
                android:textColor="@color/muted"
                android:textSize="12sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/dGeo"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_marginLeft="6dp"
            android:layout_weight="1"
            android:background="@drawable/type_off"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_globe"
                android:tint="#FFFFFF" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif-medium"
                android:text="Geography"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/dGeoSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Green"
                android:textColor="@color/muted"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
